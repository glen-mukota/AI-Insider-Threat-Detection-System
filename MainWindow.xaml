<Window x:Class="InsiderThreatDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI‑Powered Insider Threat Detection" Height="850" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F8">
    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="AI‑Powered Insider Threat Detection"
                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="#2C3E50"/>

            <!-- Training / Upload controls -->
            <StackPanel Grid.Row="2">
                <Button x:Name="UploadCsvButton" Content="Upload Training Dataset (*.csv)"
                        Height="40" FontWeight="SemiBold" Background="#2E86C1" Foreground="White"
                        Click="UploadCsvButton_Click"/>
                <Button x:Name="TrainModelButton" Content="Retrain Model"
                        Height="36" Margin="0,8,0,0" Background="#5DADE2" Foreground="White"
                        Click="TrainModelButton_Click"/>
                <Button x:Name="SaveModelButton" Content="Save Trained Model (.zip)"
                        Height="30" Margin="0,8,0,0" Background="#A569BD" Foreground="White"
                        Click="SaveModelButton_Click"/>
                <TextBlock x:Name="ModelStatusText" Margin="0,12,0,0" FontWeight="SemiBold"
                           Foreground="#C0392B" Text="Model not trained."/>
            </StackPanel>

            <!-- Sample profile selection -->
            <Border Grid.Row="4" Padding="15" Background="White" CornerRadius="6"
                    BorderBrush="#D5D8DC" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Select Sample Employee Profile" FontWeight="Bold"
                               Margin="0,0,0,12" Foreground="#2C3E50"/>
                    <ComboBox x:Name="SampleProfileComboBox" Height="30"
                              SelectionChanged="SampleProfileComboBox_SelectionChanged">
                        <ComboBoxItem Content="-- Select Profile --"/>
                        <ComboBoxItem Content="Normal Office Worker"/>
                        <ComboBoxItem Content="Suspicious Printing Activity"/>
                        <ComboBoxItem Content="Excessive Facility Access"/>
                        <ComboBoxItem Content="Critical Insider Threat"/>
                    </ComboBox>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Selecting a profile automatically runs prediction."
                               FontStyle="Italic" Foreground="#7F8C8D"/>
                </StackPanel>
            </Border>

            <!-- Upload CSV & Predict -->
            <Button Grid.Row="6" x:Name="PredictFromCsvButton"
                    Content="Upload Single CSV Record &amp; Predict"
                    Height="40" FontWeight="SemiBold" Background="#8E44AD" Foreground="White"
                    Click="PredictFromCsvButton_Click"/>

            <!-- Prediction result panel (always visible) -->
            <Border Grid.Row="8" Padding="15" Background="White" CornerRadius="6"
                    BorderBrush="#D5D8DC" BorderThickness="1" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Prediction Result" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <TextBlock x:Name="PredictionResultText" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="12"
                               Text="No prediction run yet." />
                </StackPanel>
            </Border>

            <!-- Model Evaluation & Comparison panel (always visible after training) -->
            <Border Grid.Row="10" Padding="15" Background="White" CornerRadius="6"
                    BorderBrush="#D5D8DC" BorderThickness="1" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Model Evaluation &amp; Comparison" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <TextBlock x:Name="EvaluationSummaryText" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="12"
                               Text="No model trained yet." />
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>