<Window x:Class="InsiderThreatDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI‑Powered Insider Threat Detection"
        Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <TextBlock Grid.Row="0" Text="AI‑Powered Insider Threat Detection"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="#2C3E50"/>

            <!-- TRAINING CONTROLS -->
            <StackPanel Grid.Row="2">
                <Button x:Name="UploadCsvButton" Content="Upload Training Dataset (*.csv)"
                        Height="40" FontWeight="SemiBold" Background="#2E86C1"
                        Foreground="White" Click="UploadCsvButton_Click"/>

                <Button x:Name="TrainModelButton" Content="Retrain Model"
                        Height="36" Margin="0,8,0,0" Background="#5DADE2"
                        Foreground="White" Click="TrainModelButton_Click"/>

                <Button x:Name="SaveModelButton" Content="Save Trained Model (.zip)"
                        Height="30" Margin="0,8,0,0" Background="#A569BD"
                        Foreground="White" Click="SaveModelButton_Click"/>

                <TextBlock x:Name="ModelStatusText" Margin="0,12,0,0"
                           FontWeight="SemiBold" Foreground="#C0392B"
                           Text="Model not trained."/>
            </StackPanel>

            <!-- PROFILE SELECTION -->
            <Border Grid.Row="4" Padding="15" Background="White"
                    CornerRadius="6" BorderBrush="#D5D8DC" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Select Sample Employee Behaviour Profile"
                               FontWeight="Bold" Margin="0,0,0,12" Foreground="#2C3E50"/>
                    <ComboBox x:Name="SampleProfileComboBox" Height="30"
                              SelectionChanged="SampleProfileComboBox_SelectionChanged">
                        <ComboBoxItem Content="-- Select Profile --"/>
                        <ComboBoxItem Content="Normal Office Worker"/>
                        <ComboBoxItem Content="Suspicious Printing Activity"/>
                        <ComboBoxItem Content="Excessive Facility Access"/>
                        <ComboBoxItem Content="Critical Insider Threat"/>
                    </ComboBox>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Selecting a profile automatically runs prediction."
                               FontStyle="Italic" Foreground="#7F8C8D"/>
                </StackPanel>
            </Border>

            <!-- CSV PREDICTION -->
            <Button Grid.Row="6" x:Name="PredictFromCsvButton"
                    Content="Upload Single CSV Record &amp; Predict"
                    Height="40" FontWeight="SemiBold" Background="#8E44AD"
                    Foreground="White" Click="PredictFromCsvButton_Click"/>
        </Grid>
    </ScrollViewer>
</Window>