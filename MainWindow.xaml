<Window x:Class="InsiderThreatDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-Powered Insider Threat Detection System"
        Height="980"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <!-- ROWS -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#161B22"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#30363D"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="AI Insider Threat Detection System"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="COS720 Project 2026"
                               FontSize="14"
                               Foreground="#8B949E"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,15"/>

                    <WrapPanel HorizontalAlignment="Center">

                        <Border Background="#1F6FEB"
                                CornerRadius="8"
                                Padding="8,4"
                                Margin="4">
                            <TextBlock Text="CONFIDENTIALITY"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Border>

                        <Border Background="#3FB950"
                                CornerRadius="8"
                                Padding="8,4"
                                Margin="4">
                            <TextBlock Text="INTEGRITY"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Border>

                        <Border Background="#D29922"
                                CornerRadius="8"
                                Padding="8,4"
                                Margin="4">
                            <TextBlock Text="AVAILABILITY"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- MODEL STATUS -->
            <Border Grid.Row="2"
                    Background="#161B22"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="#30363D"
                    BorderThickness="1">

                <StackPanel Orientation="Horizontal">

                    <Ellipse x:Name="StatusDot"
                             Width="14"
                             Height="14"
                             Fill="#F85149"
                             Margin="0,3,10,0"/>

                    <TextBlock x:Name="ModelStatusText"
                               Text="Model not trained."
                               Foreground="#8B949E"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- TRAINING -->
            <Border Grid.Row="4"
                    Background="#161B22"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="#30363D"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="1. Model Training &amp; Management"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               Margin="0,0,0,12"/>

                    <Button x:Name="UploadCsvButton"
                            Content="Upload Training Dataset (.csv)"
                            Height="42"
                            Background="#1F6FEB"
                            Foreground="White"
                            Click="UploadCsvButton_Click"/>

                    <Button x:Name="RetrainModelButton"
                            Content="Retrain Model"
                            Height="38"
                            Margin="0,8,0,0"
                            Background="#238636"
                            Foreground="White"
                            Click="RetrainModelButton_Click"/>

                    <Button x:Name="SaveModelButton"
                            Content="Save Trained Model"
                            Height="38"
                            Margin="0,8,0,0"
                            Background="#8957E5"
                            Foreground="White"
                            Click="SaveModelButton_Click"/>

                    <Button x:Name="LoadModelButton"
                            Content="Load Existing Model"
                            Height="38"
                            Margin="0,8,0,0"
                            Background="#D29922"
                            Foreground="White"
                            Click="LoadModelButton_Click"/>
                </StackPanel>
            </Border>

            <!-- PREPROCESSING -->
            <Border x:Name="PreprocessingPanel"
                    Grid.Row="6"
                    Visibility="Collapsed"
                    Background="#161B22"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="#30363D"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Dataset Preprocessing Summary"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="PreprocessingText"
                               TextWrapping="Wrap"
                               Foreground="#8B949E"/>
                </StackPanel>
            </Border>

            <!-- PREDICTION -->
            <Border Grid.Row="8"
                    Background="#161B22"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="#30363D"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="2. Threat Prediction"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               Margin="0,0,0,12"/>

                    <ComboBox x:Name="SampleProfileComboBox"
                              Height="35"
                              SelectionChanged="SampleProfileComboBox_SelectionChanged">
                        <ComboBoxItem Content="-- Select Sample Profile --"/>
                        <ComboBoxItem Content="Normal Office Worker"/>
                        <ComboBoxItem Content="Suspicious Printing Activity"/>
                        <ComboBoxItem Content="Excessive Facility Access"/>
                        <ComboBoxItem Content="Critical Insider Threat"/>
                    </ComboBox>

                    <Button x:Name="PredictFromCsvButton"
                            Content="Upload Single CSV Record &amp; Predict"
                            Height="38"
                            Margin="0,10,0,0"
                            Background="#BC4C00"
                            Foreground="White"
                            Click="PredictFromCsvButton_Click"/>

                    <TextBlock x:Name="ThresholdBadge"
                               Visibility="Collapsed"
                               Margin="0,12,0,0"
                               Foreground="#58A6FF"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- RISK VISUAL -->
            <StackPanel Grid.Row="10">

                <Border x:Name="ClassificationBar"
                        Height="28"
                        Background="#30363D"
                        CornerRadius="8"
                        Visibility="Collapsed">

                    <Grid>
                        <Border x:Name="ClassificationFill"
                                HorizontalAlignment="Left"
                                Background="#3FB950"
                                CornerRadius="8"/>
                    </Grid>
                </Border>

                <Border x:Name="RiskBadge"
                        Visibility="Collapsed"
                        Background="#F85149"
                        Padding="10,5"
                        Margin="0,8,0,0"
                        CornerRadius="8"
                        HorizontalAlignment="Left">

                    <TextBlock x:Name="RiskBadgeText"
                               Foreground="White"
                               FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- RESULTS -->
            <Border Grid.Row="12"
                    Background="#161B22"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="#30363D"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Prediction &amp; Evaluation Results"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="PredictionResultText"
                               Text="Awaiting prediction..."
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               Foreground="#E6EDF3"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="EvaluationSummaryText"
                               Text="No evaluation available yet."
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               Foreground="#8B949E"/>
                </StackPanel>
            </Border>

            <!-- AUDIT LOG -->
            <Border Grid.Row="14"
                    Margin="0,15,0,0"
                    Background="#161B22"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="#30363D"
                    BorderThickness="1">

                <StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audit Log"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#E6EDF3"/>

                        <Button x:Name="RefreshAuditBtn"
                                Content="Refresh"
                                Margin="15,0,0,0"
                                Padding="10,3"
                                Click="RefreshAuditBtn_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="AuditLogPathText"
                               Margin="0,8,0,8"
                               Foreground="#8B949E"/>

                    <TextBox x:Name="AuditLogText"
                             Height="180"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#0D1117"
                             Foreground="#C9D1D9"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>